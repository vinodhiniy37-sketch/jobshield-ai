# ==========================================
# JobShield AI Environment Configuration
# ==========================================

# Backend API Base URL (Default for local: http://localhost:5000/api)
# For production: https://jobshield-api.onrender.com/api
API_BASE_URL=http://localhost:5000/api

# Backend Server Port
PORT=5000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jobscam_guard?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_minimum_32_chars

# Optional AI Engine Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
