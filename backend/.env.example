# Node.js Server Port
PORT=5000

# Environment Mode: development | production
NODE_ENV=production

# MongoDB Connection String (Local or MongoDB Atlas)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jobscam_guard?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jobscam_guard?retryWrites=true&w=majority

# JWT Token Encryption Secret Key (Use a strong random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_chars

# Allowed CORS Origins (Comma-separated for multiple domains)
# Example: https://jobshield-ai.web.app,https://jobshield.vercel.app
CORS_ORIGIN=*

# Optional: Cloud LLM API Keys for AI Assistant (Rule-based engine active if omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=
